# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Unity text assets
*.meta text
*.asset text
*.unity text
*.prefab text
*.mat text
*.anim text
*.controller text
*.overrideController text
*.physicMaterial text
*.physicsMaterial2D text
*.shader text
*.cginc text
*.hlsl text
*.compute text
*.asmdef text
*.json text
*.md text

# Binary assets (never merge, never convert)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.tga binary
*.tif binary
*.exr binary
*.hdr binary
*.wav binary
*.mp3 binary
*.ogg binary
*.aiff binary
*.ttf binary
*.otf binary
*.fbx binary
*.blend binary
*.dll binary
*.so binary
*.bundle binary
*.zip binary
